{
  "name": "vyora",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "VYORA — SaaS de création de contenus UGC et de croissance assistée par IA",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
