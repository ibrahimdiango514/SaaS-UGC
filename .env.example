# ===========================================================================
# SORAHNEX — référence des variables d'environnement
# ===========================================================================
# Ce fichier ne contient AUCUNE valeur réelle : uniquement des noms et des
# placeholders non sensibles. Ne jamais y écrire une clé, un jeton ou un mot de
# passe, même « juste pour tester » : il est versionné et public.
#
# Inventaire détaillé (obligation, fonctionnalité dépendante, risque si
# absente) : docs/NETLIFY_ENVIRONMENT_CHECKLIST.md
#
# Quatre familles, à ne pas mélanger :
#   A. Frontend public (VITE_)      → exposé au navigateur, figé au build
#   B. Netlify runtime              → lu par la garde de build, jamais par l'app
#   C. Secrets backend Supabase     → jamais côté navigateur, jamais dans Netlify
#   D. Facultatif / par connecteur  → à déclarer seulement si la fonctionnalité
#                                     est utilisée
# ===========================================================================

# ---------------------------------------------------------------------------
# A. VARIABLES FRONTEND PUBLIQUES (préfixe VITE_ — visibles dans le bundle)
# ---------------------------------------------------------------------------
# Copier vers `.env.local` pour le développement local.
# En production, à déclarer sur le site Netlify : elles sont FIGÉES au moment du
# build. Les changer exige un NOUVEAU déploiement — donc un crédit Netlify.

# Projet Supabase. Obligatoire. Aucun repli codé en dur n'est souhaitable ici.
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# Clé PUBLIABLE (sb_publishable_…) ou clé anon historique. Obligatoire.
# JAMAIS la clé service_role ni une clé secrète serveur : elles contournent la RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=<CLE_PUBLIABLE_OU_ANON>

# Origine publique de l'application. Obligatoire pour des redirections fiables.
# Sans elle, le code se replie sur `window.location.origin` : cela fonctionne,
# mais rend les liens de confirmation dépendants de l'origine d'ouverture.
# Doit correspondre à une entrée de `uri_allow_list` côté Supabase Auth.
VITE_SITE_URL=https://<NOUVEAU_SITE>.netlify.app

# Facultatif, développement local uniquement. Supabase Edge local.
# Vite joint cette adresse côté serveur via /api/business-grow ; le navigateur
# n'appelle jamais localhost sur un autre port. Ne pas définir en production.
# VITE_BUSINESS_GROW_FUNCTION_URL=http://127.0.0.1:54321/functions/v1/business-grow

# Facultatif. Drapeau de nommage des Edge Functions (`legacy` / `canonical`).
# Laisser absent en production : les noms techniques historiques restent utilisés
# volontairement pour la compatibilité (voir docs/migration-nouveau-netlify.md).
# VITE_SORAHNEX_EDGE_NAMING=<legacy|canonical>

# ---------------------------------------------------------------------------
# B. VARIABLES NETLIFY RUNTIME (lu par la garde de build, jamais par l'app)
# ---------------------------------------------------------------------------
# À NE DÉCLARER SUR LE SITE QUE POUR AUTORISER UNE PUBLICATION.
# Netlify fournit déjà SITE_ID, SITE_NAME et BRANCH : ne pas les déclarer à la main.
#
# L'identité autorisée vit dans `netlify.site.conf` (versionné), pas ici.

# Ces trois lignes sont COMMENTÉES volontairement : .env.example ne doit contenir
# aucune variable assignable hors VITE_, sinon une vraie valeur finit par y être
# collée. À déclarer dans l'interface Netlify (Site configuration → Environment
# variables), jamais ici.
# Opt-in de build du site. Obligatoire pour publier. Valeur exacte : true
# VYORA_BUILD_ENABLED=true

# Verrou de crédits — AUTORISATION HUMAINE. Deux variables, ensemble, valeur exacte.
# À déclarer juste avant de publier, puis À RETIRER aussitôt après.
# Un déploiement de production réussi coûte 15 crédits Netlify, et l'épuisement du
# pool met TOUS les sites de l'équipe en pause.
# SORAHNEX_DEPLOY_AUTHORIZED=<true>
# SORAHNEX_DEPLOY_AUTHORIZED_NAME=sorahnex-deploy

# ---------------------------------------------------------------------------
# C. SECRETS BACKEND SUPABASE (Edge Functions → Supabase › Edge Functions › Secrets)
# ---------------------------------------------------------------------------
# NE JAMAIS préfixer VITE_. NE JAMAIS déclarer sur Netlify. NE JAMAIS versionner.
# `supabase secrets set NOM=valeur` ou tableau de bord.

# --- Injectés automatiquement par Supabase : ne pas les déclarer à la main -----
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_PUBLISHABLE_KEY,
# SUPABASE_SERVICE_ROLE_KEY, SUPABASE_DB_URL

# --- Studio — fournisseur vidéo principal (obligatoire pour générer) -----------
# MUAPI_API_KEY=<CLE_MUAPI>

# --- Studio — URL publique du worker si différente de la valeur par défaut -----
# Défaut : ${SUPABASE_URL}/functions/v1/reelora-video-worker
# REELORA_WEBHOOK_BASE_URL=https://<PROJECT_REF>.supabase.co/functions/v1/reelora-video-worker

# --- Passerelle IA (vyora-ai) — assistant, scripts, briefs --------------------
# FREE_LLM_API_KEY=<CLE_FREELLMAPI>
# FREE_LLM_API_BASE_URL=https://<HOTE_FREELLMAPI>/v1
# FREE_LLM_DEFAULT_MODEL=<modele>          (facultatif)

# --- Business Grow — assistant d'entreprise (séparé de la passerelle ci-dessus) -
# Grow lit BUSINESS_GROW_<FOURNISSEUR>_API_KEY, et non FREE_LLM_*.
# Sans ces clés, Grow répond mais ne peut générer aucune réponse assistée.
# business-grow › status renvoie alors enabled=false / config_status=missing.
# BUSINESS_GROW_OPENAI_API_KEY=<CLE_FOURNISSEUR>
# BUSINESS_GROW_<FOURNISSEUR>_BASE_URL=<URL_OPENAI_COMPATIBLE>
# BUSINESS_GROW_<FOURNISSEUR>_MODEL=<modele>
# BUSINESS_GROW_PROVIDER_ORDER=<fournisseur1,fournisseur2>   (facultatif)
# BUSINESS_GROW_DATABASE_URL=<CHAINE_POSTGRES_ROLE_BG_EDGE>  (facultatif ; repli SUPABASE_DB_URL)

# --- Paiement SasPay ----------------------------------------------------------
# SASPAY_SECRET_KEY et VYORA_SASPAY_SECRET_KEY sont deux générations de secret ;
# le code lit les deux. Déclarer celle utilisée par le compte SasPay actif.
# SASPAY_SECRET_KEY=<CLE_SASPAY>
# SASPAY_WEBHOOK_SECRET=<SECRET_WEBHOOK_SASPAY>
# VYORA_SASPAY_SECRET_KEY=<CLE_SASPAY>
# VYORA_SASPAY_WEBHOOK_SECRET=<SECRET_WEBHOOK_SASPAY>

# --- OAuth (chiffrement des jetons stockés) -----------------------------------
# VYORA_OAUTH_ENCRYPTION_KEY=<CLE_32_OCTETS>
# MCP_CLIENT_CALLBACK_URL=https://<PROJECT_REF>.supabase.co/functions/v1/mcp-client/oauth/callback
# VYORA_MCP_RESOURCE_URL=https://<PROJECT_REF>.supabase.co/functions/v1/vyora-mcp

# --- Administration -----------------------------------------------------------
# VYORA_OWNER_ADMIN_EMAIL=<EMAIL_ADMIN_PROPRIETAIRE>

# --- CORS : origines autorisées des Edge Functions ---------------------------
# Ces valeurs NOMBENT les origines du site publié. Lors de la migration, y ajouter
# la nouvelle origine AVANT de retirer l'ancienne, sinon les appels du nouveau
# site sont bloqués par le navigateur.
# BUSINESS_GROW_ALLOWED_ORIGINS=https://<NOUVEAU_SITE>.netlify.app
# VYORA_ALLOWED_ORIGINS=https://<NOUVEAU_SITE>.netlify.app
# STORE_IMPORT_ALLOWED_ORIGINS=https://<NOUVEAU_SITE>.netlify.app
# VYORA_PAYMENTS_ALLOWED_ORIGINS=https://<NOUVEAU_SITE>.netlify.app

# --- MCP : écriture désactivée par défaut ------------------------------------
# N'activer que si le serveur MCP doit réellement modifier des données.
# VYORA_MCP_WRITE_ENABLED=<true|false>

# --- Connecteurs de boutique : chaîne PostgreSQL dédiée (facultatif) ----------
# Repli sur SUPABASE_DB_URL si absent.
# STORE_IMPORT_DATABASE_URL=<CHAINE_POSTGRES>
# STORE_CONNECT_DATABASE_URL=<CHAINE_POSTGRES>

# ---------------------------------------------------------------------------
# D. FACULTATIF / PAR CONNECTEUR
# ---------------------------------------------------------------------------
# Connecteurs sociaux : aucune de ces variables n'est nécessaire pour que
# l'application fonctionne. Sans elles, les connecteurs concernés s'affichent
# « indisponible » dans le catalogue — et c'est exact.
# META_APP_ID=<APP_ID_META>
# TIKTOK_CLIENT_KEY=<CLE_TIKTOK>
# GOOGLE_CLIENT_ID=<CLIENT_ID_GOOGLE>
# LINKEDIN_CLIENT_ID=<CLIENT_ID_LINKEDIN>
# PINTEREST_APP_ID=<APP_ID_PINTEREST>
#
# Magento / Wix / BigCommerce / Squarespace : clé lue côté serveur, à déclarer
# seulement si ces catalogues sont utilisés.
# MAGENTO_ALLOW_KEYS=<true|false>
# WIX_API_KEY=<CLE_WIX>
# BIGCOMMERCE_API_KEY=<CLE_BIGCOMMERCE>
# SQUARESPACE_API_KEY=<CLE_SQUARESPACE>
#
# Shopify, WooCommerce, PrestaShop et Chariow ne demandent AUCUNE variable
# globale : le marchand fournit sa propre clé, vérifiée côté serveur.
