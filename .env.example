# ---------------------------------------------------------------------------
# Reelora — variables d'environnement FRONTEND (Vite)
# Copiez ce fichier vers .env.local puis renseignez les valeurs.
# N'y placez JAMAIS une clé secrète : tout ce qui commence par VITE_ est public.
# ---------------------------------------------------------------------------

# URL du projet Supabase (Reelora / schéma saas_ugc)
VITE_SUPABASE_URL=https://xbuuhfwobrafcbgtdgjx.supabase.co

# Clé PUBLISHABLE (ou clé anon legacy). Jamais la service_role / sb_secret.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_utbZhw8dg-2M1-g0nXIhfA_n6dZCDZz

# URL publique de l'application (utilisée pour les redirections de connexion)
VITE_SITE_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Secrets SERVEUR : à configurer dans Supabase > Edge Functions > Secrets
# (ou `supabase secrets set MUAPI_API_KEY=...`).
# Ils ne doivent JAMAIS être préfixés VITE_, ni apparaître dans le frontend,
# dans un fichier .env versionné, dans les logs ou dans une réponse HTTP.
#
# MUAPI_API_KEY                OBLIGATOIRE — fournisseur vidéo PRINCIPAL (MuAPI)
#                              transmis uniquement dans l'en-tête x-api-key,
#                              depuis reelora-video / reelora-video-worker.
# GROQ_API_KEY                 obligatoire — scripts, accroches, dialogues (Groq)
# GROQ_MODEL                  optionnel   — défaut llama-3.3-70b-versatile
# REELORA_WEBHOOK_BASE_URL    optionnel   — URL publique du worker si elle
#                              diffère de ${SUPABASE_URL}/functions/v1/reelora-video-worker
#
# Aucun secret HeyGen / fal.ai n'est nécessaire : MuAPI est le seul fournisseur
# vidéo de Reelora. Les anciennes variables sont retirées pour éviter toute
# confusion (elles ne sont pas lues par le code).
#
# Jeton worker : généré automatiquement par la migration
# 20261108000009_reelora_muapi.sql dans Supabase Vault sous le nom
# `reelora_worker_token` (jamais exposé au navigateur). Il protège le callback
# MuAPI et l'appel pg_cron / pg_net.
#
# Injectés automatiquement par Supabase dans les Edge Functions :
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
# ---------------------------------------------------------------------------
