{
  "//": "Vérification de types des Edge Functions Deno — absente jusqu'ici.",
  "//_pourquoi": [
    "`tsconfig.json` ne couvrait que `src/` et `tests/`. Les Edge Functions",
    "n'étaient donc jamais vérifiées : l'oubli de l'import de `importFile` y est",
    "resté invisible, et l'import de fichier échouait en 500 à l'exécution.",
    "Ce fichier-ci les couvre, avec les globales Deno et sans émettre de code."
  ],
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "supabase/functions/universal-catalog/*.ts",
    "supabase/functions/video-quote/index.ts",
    "supabase/functions/vyora-provider-discovery/index.ts",
    "supabase/functions/_shared/ai-core/anthropic.ts",
    "supabase/functions/reelora-video/index.ts",
    "supabase/functions/store-import/index.ts",
    "supabase/functions/store-import/handler.ts",
    "supabase/functions/store-connect/index.ts",
    "supabase/functions/store-connect/handler.ts",
    "supabase/functions/types/*.d.ts",
    "supabase/functions/vyora-mcp/index.ts",
    "supabase/functions/vyora-mcp/handler.ts",
    "supabase/functions/vyora-mcp/core.ts",
    "supabase/functions/vyora-mcp/oauth.ts",
    "supabase/functions/vyora-mcp/oauth-routes.ts",
    "supabase/functions/vyora-mcp/consentement.ts",
    "supabase/functions/mcp-client/client.ts",
    "supabase/functions/mcp-client/external.ts",
    "supabase/functions/mcp-client/execution.ts",
    "supabase/functions/mcp-client/route.ts",
    "supabase/functions/mcp-client/http.ts",
    "supabase/functions/mcp-client/gestion.ts",
    "supabase/functions/mcp-client/gestion-serveur.ts",
    "supabase/functions/mcp-client/gestion-http.ts",
    "supabase/functions/mcp-client/accueil.ts",
    "supabase/functions/mcp-client/index.ts"
  ]
}
